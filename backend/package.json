{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.tools.json && tsc",
    "start": "node dist/server.js",
    "test": "tsx --test src/**/*.test.ts",
    "verify-drive": "tsx --env-file=.env scripts/verify-drive.ts",
    "oauth": "tsx --env-file=.env scripts/oauth.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "file-type": "^21.0.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
